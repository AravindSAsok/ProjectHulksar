---
import Layout from "../layouts/Layout.astro";
---
<Layout title="messCulator — Hulksar" description="A simple shared budget and expense splitter.">
  <main class="mc-shell">
    <header class="mc-topbar">
      <a class="mc-brand" href="/" aria-label="Back to Hulksar"><span class="mc-mark">H</span><span>HULK<span>SAR</span></span></a>
      <a class="mc-back" href="/apps">Customize apps</a><a class="mc-back" href="/">← Hulksar</a>
    </header>
    <section class="mc-hero">
      <div><p class="mc-eyebrow">HULKSAR MINI APP</p><h1>mess<span>Culator</span></h1><p class="mc-subtitle">One budget. Every expense. Everyone accounted for.</p></div>
      <div class="mc-local" id="sync-status" role="status" aria-live="polite"><span></span> Saved on this device</div>
    </section>
    <section class="mc-budget-grid" aria-label="Budget summary">
      <article class="mc-card mc-budget-card">
        <div class="mc-card-head"><div><p class="mc-label">YOUR TOTAL BUDGET</p><h2 id="budget-display">₹0.00</h2></div><button class="mc-quiet" id="edit-budget" type="button">Edit budget</button></div>
        <div class="mc-budget-track"><span id="budget-progress"></span></div>
        <div class="mc-budget-meta"><span id="spent-label">₹0 spent</span><span id="budget-percent">0%</span></div>
        <div class="mc-budget-stats"><div><small>Expenses</small><strong id="spent-total">₹0.00</strong></div><div><small>Budget left</small><strong id="budget-left">₹0.00</strong></div><div><small>Borrowed</small><strong id="borrowed-total">₹0.00</strong></div></div>
      </article>
      <article class="mc-card mc-balance-card"><p class="mc-label">AVAILABLE CASH</p><strong id="cash-balance">₹0.00</strong><p id="cash-caption">Set a budget to get started.</p><div class="mc-borrow-line"><span>Borrowed funds still available</span><strong id="borrowed-left">₹0.00</strong></div></article>
    </section>
    <section class="mc-card mc-monthly-card" aria-labelledby="monthly-title">
      <div class="mc-section-head"><div><p class="mc-label">FINANCIAL OVERVIEW</p><h2 id="monthly-title">Monthly report</h2></div><label class="mc-month-picker">Choose month<input id="report-month" type="month" /></label></div>
      <div class="mc-month-stats"><div><small>Expenses this month</small><strong id="month-expenses">₹0.00</strong></div><div><small>Borrowed this month</small><strong id="month-borrowed">₹0.00</strong></div><div><small>Net cash movement</small><strong id="month-net">₹0.00</strong></div><div><small>Transactions</small><strong id="month-count">0</strong></div></div>
      <div class="mc-month-lower"><div><p class="mc-label">PERSON-WISE MONTHLY SHARE</p><div id="month-people" class="mc-month-people"><p class="mc-empty-small">No expenses in this month.</p></div></div><div><p class="mc-label">BORROWING HISTORY</p><div id="month-borrowing-list" class="mc-month-people"><p class="mc-empty-small">No borrowing recorded this month.</p></div><p id="legacy-borrowing-note" class="mc-helper" hidden></p></div></div>
    </section>
    <section class="mc-main-grid">
      <div class="mc-column">
        <article class="mc-card">
          <div class="mc-section-head"><div><p class="mc-label">KEEP TRACK</p><h2>Add an expense</h2></div><span class="mc-icon">＋</span></div>
          <form id="expense-form" class="mc-form">
            <label>Expense amount <span class="mc-required">*</span><input id="expense-amount" type="number" min="0.01" step="0.01" placeholder="e.g. 450" required /></label>
            <label>Expense name <span class="mc-optional">optional</span><input id="expense-name" maxlength="80" placeholder="Groceries, rent, travel…" /></label>
            <label>Split this expense<select id="split-mode"><option value="equal">Equally between everyone</option><option value="custom">Set each person's amount</option></select></label>
            <div id="custom-split" class="mc-custom-split" hidden><p>Enter each person's share. Shares must add up to the expense total.</p><div id="custom-fields"></div><p class="mc-split-total" id="custom-total">Allocated: ₹0.00</p></div>
            <button class="mc-primary" type="submit">＋ Add expense</button>
            <p class="mc-form-status" id="expense-status" role="status"></p>
          </form>
        </article>
        <article class="mc-card">
          <div class="mc-section-head"><div><p class="mc-label">PEOPLE IN THIS BUDGET</p><h2>Who's sharing?</h2></div><span class="mc-icon">♧</span></div>
          <form id="person-form" class="mc-person-form"><label class="mc-sr" for="person-name">Person's name</label><input id="person-name" maxlength="40" placeholder="Add a person's name" required /><button class="mc-secondary" type="submit">Add person</button></form>
          <p class="mc-helper">Everyone shares equally by default. Choose custom split when adding an expense to set individual amounts.</p>
          <div id="people-list" class="mc-people-list"><p class="mc-empty-small">No people added yet. Add people to split expenses.</p></div>
        </article>
      </div>
      <div class="mc-column">
        <article class="mc-card">
          <div class="mc-section-head"><div><p class="mc-label">EXTRA FUNDS</p><h2>Borrowed money</h2></div><span class="mc-icon">↗</span></div>
          <p class="mc-helper mc-helper-top">Record money borrowed to cover expenses. It increases available cash, but stays separate from your original budget.</p>
          <form id="borrow-form" class="mc-borrow-form"><label class="mc-sr" for="borrow-amount">Borrowed amount</label><input id="borrow-amount" type="number" min="0.01" step="0.01" placeholder="Amount borrowed" required /><button class="mc-secondary" type="submit">＋ Add borrowed money</button></form>
          <div class="mc-borrow-summary"><span>Total borrowed</span><strong id="borrow-summary-value">₹0.00</strong></div>
        </article>
        <article class="mc-card">
          <div class="mc-section-head"><div><p class="mc-label">WHERE IT WENT</p><h2>Expense history</h2></div><span class="mc-count" id="expense-count">0 items</span></div>
          <div id="expense-list" class="mc-expense-list"><div class="mc-empty"><span>◌</span><strong>No expenses this month</strong><p>Choose another month or add an expense.</p></div></div>
        </article>
      </div>
    </section>
    <section class="mc-card mc-split-card"><div class="mc-section-head"><div><p class="mc-label">FAIR SHARE</p><h2>Per-person breakdown</h2></div><span class="mc-count" id="split-count">0 people</span></div><div id="person-breakdown" class="mc-breakdown"><p class="mc-empty-small">Add people and expenses to see each person&#39;s share.</p></div></section>
    <footer class="mc-footer"><span>messCulator · part of Hulksar</span><button id="reset-app" type="button">Reset this budget</button></footer>
  </main>
  <dialog id="budget-dialog" class="mc-dialog"><form id="budget-form" method="dialog"><div class="mc-dialog-head"><div><p class="mc-label">STARTING POINT</p><h2>Set your budget</h2></div><button class="mc-close" type="button" data-close>×</button></div><p class="mc-helper">Enter the total amount available before borrowing.</p><label>Total budget (₹)<input id="budget-amount" type="number" min="0" step="0.01" placeholder="e.g. 10000" required /></label><div class="mc-dialog-actions"><button class="mc-secondary" type="button" data-close>Cancel</button><button class="mc-primary" type="submit">Save budget</button></div></form></dialog>
  <dialog id="confirm-dialog" class="mc-dialog"><div class="mc-dialog-head"><div><p class="mc-label">START FRESH</p><h2>Reset this budget?</h2></div><button class="mc-close" type="button" data-close>×</button></div><p class="mc-helper">This clears this device's messCulator budget, people, borrowed amounts and expenses. This cannot be undone.</p><div class="mc-dialog-actions"><button class="mc-secondary" type="button" data-close>Keep my data</button><button class="mc-danger" id="confirm-reset" type="button">Reset everything</button></div></dialog>
</Layout>
<style>
:root{--mc-bg:#0d0d10;--mc-panel:#17171c;--mc-border:#2b2b33;--mc-text:#f4f1f2;--mc-muted:#a6a0a4;--mc-accent:#d77b8b;--mc-green:#8ac6a0;--mc-red:#ff8189}
html[data-theme="light"]{--mc-bg:#f6f2f3;--mc-panel:#fff;--mc-border:#e7dfe2;--mc-text:#272126;--mc-muted:#776d72;--mc-accent:#a94f65;--mc-green:#267a4a;--mc-red:#c43c4c}
.mc-shell{max-width:1120px;margin:auto;padding:28px 28px 36px;color:var(--mc-text);min-height:100vh}.mc-topbar,.mc-brand,.mc-section-head,.mc-card-head,.mc-budget-meta,.mc-budget-stats,.mc-borrow-line,.mc-footer,.mc-dialog-head,.mc-dialog-actions{display:flex;align-items:center;justify-content:space-between;gap:14px}.mc-topbar{padding-bottom:28px;border-bottom:1px solid var(--mc-border)}.mc-brand{justify-content:flex-start;text-decoration:none;color:var(--mc-text);font-weight:900;letter-spacing:.12em}.mc-brand>span:last-child>span{color:var(--mc-accent)}.mc-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:var(--mc-accent);color:#171217;font-size:19px}.mc-back{color:var(--mc-muted);text-decoration:none;font-size:13px}.mc-back:hover{color:var(--mc-text)}.mc-hero{display:flex;align-items:end;justify-content:space-between;gap:18px;padding:38px 0 26px}.mc-eyebrow,.mc-label{font-size:10px;letter-spacing:.16em;font-weight:800;color:var(--mc-muted);margin:0 0 8px}.mc-hero h1{font-size:clamp(32px,5vw,48px);letter-spacing:-.055em;margin:0;font-weight:850}.mc-hero h1 span{color:var(--mc-accent)}.mc-subtitle{color:var(--mc-muted);margin:8px 0 0;font-size:14px}.mc-local{font-size:11px;color:var(--mc-muted);display:flex;align-items:center;gap:8px;white-space:nowrap}.mc-local span{width:7px;height:7px;border-radius:50%;background:var(--mc-green)}.mc-budget-grid{display:grid;grid-template-columns:1.45fr 1fr;gap:16px}.mc-card{background:var(--mc-panel);border:1px solid var(--mc-border);border-radius:18px;padding:22px;min-width:0}.mc-budget-card{background:linear-gradient(135deg,#352027,#1d191e 72%);border-color:#56323b}.mc-card-head h2{font-size:32px;margin:0;letter-spacing:-.04em}.mc-quiet{background:transparent;border:1px solid #76505a;color:#f3c4cc;border-radius:9px;padding:8px 12px;font-size:12px}.mc-budget-track{height:8px;border-radius:9px;background:#ffffff20;margin:22px 0 9px;overflow:hidden}.mc-budget-track span{height:100%;display:block;width:0;background:#e9a4b0;border-radius:9px;transition:width .2s}.mc-budget-meta{font-size:11px;color:#d9bfc5}.mc-budget-stats{justify-content:flex-start;gap:clamp(16px,4vw,44px);padding-top:22px;margin-top:18px;border-top:1px solid #ffffff20}.mc-budget-stats div{display:grid;gap:5px}.mc-budget-stats small{color:#d2b9bf;font-size:10px}.mc-budget-stats strong{font-size:15px;color:#fff}.mc-balance-card{display:flex;flex-direction:column;justify-content:center}.mc-balance-card>strong{font-size:36px;letter-spacing:-.05em;margin:4px 0}.mc-balance-card>p:not(.mc-label){font-size:12px;color:var(--mc-muted);margin:0 0 22px}.mc-borrow-line{font-size:11px;color:var(--mc-muted);padding-top:14px;border-top:1px solid var(--mc-border)}.mc-borrow-line strong{color:var(--mc-green);font-size:13px}.mc-monthly-card{margin-top:16px}.mc-month-picker{display:flex;align-items:center;gap:9px;color:var(--mc-muted);font-size:11px}.mc-month-picker input{background:var(--mc-bg);color:var(--mc-text);border:1px solid var(--mc-border);border-radius:9px;padding:8px;font:inherit}.mc-month-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.mc-month-stats>div{padding:14px;border:1px solid var(--mc-border);border-radius:12px;display:grid;gap:7px}.mc-month-stats small{font-size:10px;color:var(--mc-muted)}.mc-month-stats strong{font-size:17px;overflow-wrap:anywhere}.mc-month-lower{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px;padding-top:16px;border-top:1px solid var(--mc-border)}.mc-month-people{display:grid;gap:8px}.mc-month-person,.mc-month-borrowing{display:flex;justify-content:space-between;gap:12px;padding:9px 11px;border:1px solid var(--mc-border);border-radius:10px;font-size:11px}.mc-month-person strong,.mc-month-borrowing strong{white-space:nowrap}.mc-main-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px;align-items:start}.mc-column{display:grid;gap:16px;min-width:0}.mc-section-head{margin-bottom:18px}.mc-section-head h2,.mc-dialog h2{font-size:20px;margin:0;letter-spacing:-.03em}.mc-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:color-mix(in srgb,var(--mc-accent) 15%,transparent);color:var(--mc-accent);font-size:19px}.mc-form,.mc-dialog form{display:grid;gap:13px}.mc-form label,.mc-dialog label{display:grid;gap:7px;color:var(--mc-muted);font-size:11px;font-weight:650}.mc-form input,.mc-form select,.mc-person-form input,.mc-borrow-form input,.mc-dialog input{width:100%;min-width:0;background:var(--mc-bg);border:1px solid var(--mc-border);color:var(--mc-text);border-radius:10px;padding:12px 13px;font:inherit;font-size:13px;outline:none}.mc-form input:focus,.mc-form select:focus,.mc-person-form input:focus,.mc-borrow-form input:focus,.mc-dialog input:focus{border-color:var(--mc-accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--mc-accent) 15%,transparent)}.mc-required{color:var(--mc-red)}.mc-optional{font-weight:400;color:var(--mc-muted)}.mc-primary,.mc-secondary,.mc-danger{border:0;border-radius:10px;padding:12px 16px;font-weight:750;font-size:12px;cursor:pointer}.mc-primary{background:var(--mc-accent);color:#211419}.mc-secondary{background:color-mix(in srgb,var(--mc-accent) 14%,var(--mc-panel));color:var(--mc-text);border:1px solid color-mix(in srgb,var(--mc-accent) 32%,var(--mc-border))}.mc-danger{background:#8d303c;color:white}.mc-form-status{font-size:11px;color:var(--mc-red);min-height:14px;margin:0}.mc-person-form,.mc-borrow-form{display:flex;gap:9px}.mc-person-form input,.mc-borrow-form input{flex:1}.mc-helper{font-size:11px;line-height:1.6;color:var(--mc-muted);margin:0}.mc-helper-top{margin:-8px 0 16px}.mc-people-list{display:flex;flex-wrap:wrap;gap:8px;margin-top:15px}.mc-person-chip{border:1px solid var(--mc-border);border-radius:999px;padding:7px 10px;font-size:11px;display:flex;gap:8px;align-items:center}.mc-person-chip button{background:none;border:0;color:var(--mc-muted);font-size:15px;padding:0;cursor:pointer}.mc-empty-small{font-size:11px;color:var(--mc-muted);margin:0}.mc-borrow-summary{display:flex;justify-content:space-between;border-top:1px solid var(--mc-border);padding-top:14px;margin-top:16px;font-size:11px;color:var(--mc-muted)}.mc-borrow-summary strong{color:var(--mc-green);font-size:14px}.mc-count{font-size:10px;color:var(--mc-muted);border:1px solid var(--mc-border);border-radius:99px;padding:5px 9px}.mc-expense-list{display:grid;gap:9px}.mc-expense{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px;border:1px solid var(--mc-border);border-radius:12px}.mc-expense-main{min-width:0}.mc-expense-main strong{display:block;font-size:12px;overflow-wrap:anywhere}.mc-expense-main small{display:block;color:var(--mc-muted);font-size:10px;margin-top:4px}.mc-expense-side{text-align:right;white-space:nowrap}.mc-expense-side strong{font-size:13px}.mc-expense-side button{display:block;margin:5px 0 0 auto;background:none;border:0;color:var(--mc-muted);font-size:10px;text-decoration:underline;cursor:pointer}.mc-empty{text-align:center;padding:24px 8px;color:var(--mc-muted)}.mc-empty span{font-size:25px;color:var(--mc-accent)}.mc-empty strong{display:block;font-size:12px;color:var(--mc-text);margin:6px}.mc-empty p{font-size:11px;margin:0}.mc-split-card{margin-top:16px}.mc-breakdown{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}.mc-person-stat{padding:14px;border:1px solid var(--mc-border);border-radius:12px}.mc-person-stat strong{display:block;font-size:14px;margin:7px 0 3px}.mc-person-stat small{font-size:10px;color:var(--mc-muted)}.mc-person-stat span{font-size:11px;color:var(--mc-accent)}.mc-custom-split{padding:12px;background:var(--mc-bg);border-radius:12px;border:1px solid var(--mc-border)}.mc-custom-split>p{font-size:10px;color:var(--mc-muted);margin:0 0 10px}.mc-custom-row{display:grid;grid-template-columns:1fr 110px;gap:10px;align-items:center;margin:8px 0;font-size:11px}.mc-custom-row input{padding:8px}.mc-custom-split .mc-split-total{margin:12px 0 0;color:var(--mc-text);font-weight:700}.mc-footer{margin-top:22px;padding:18px 2px;color:var(--mc-muted);font-size:10px}.mc-footer button{border:0;background:none;color:var(--mc-muted);font:inherit;text-decoration:underline;cursor:pointer}.mc-dialog{width:min(430px,calc(100% - 28px));background:var(--mc-panel);color:var(--mc-text);border:1px solid var(--mc-border);border-radius:18px;padding:22px}.mc-dialog::backdrop{background:#000a;backdrop-filter:blur(3px)}.mc-dialog-head{margin-bottom:14px}.mc-close{border:0;background:none;color:var(--mc-muted);font-size:24px;cursor:pointer}.mc-dialog-actions{justify-content:flex-end;margin-top:8px}.mc-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:760px){.mc-month-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.mc-month-lower{grid-template-columns:1fr}.mc-month-picker{align-items:flex-start;flex-direction:column}.mc-shell{padding:18px 15px 28px}.mc-hero{padding:28px 0 20px;align-items:start;flex-direction:column}.mc-budget-grid,.mc-main-grid{grid-template-columns:1fr}.mc-card{padding:18px;border-radius:15px}.mc-card-head h2{font-size:28px}.mc-budget-stats{gap:22px}.mc-budget-stats strong{font-size:13px}.mc-balance-card>strong{font-size:32px}.mc-footer{align-items:flex-start}.mc-person-form,.mc-borrow-form{flex-wrap:wrap}.mc-person-form input,.mc-borrow-form input{flex-basis:100%}.mc-person-form button,.mc-borrow-form button{width:100%}}
@media(prefers-reduced-motion:reduce){.mc-budget-track span{transition:none}}
</style>
<script is:inline>
(() => {
  const KEY = "hulksar-messculator-v1";
  const $ = (id) => document.getElementById(id);
  const money = (n) => new Intl.NumberFormat("en-IN",{style:"currency",currency:"INR",maximumFractionDigits:2}).format((Number(n)||0)/100);
  const toCents = (v) => Math.round((Number(v)||0)*100);
  const escapeHtml = (v) => String(v ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  const makeId = () => (crypto.randomUUID ? crypto.randomUUID() : String(Date.now())+Math.random().toString(16).slice(2));
  const blank = () => ({budget:0,borrowed:0,legacyBorrowed:0,borrowings:[],people:[],expenses:[]});
  let state = blank();
  let cloudReady = false;
  let localRevision = 0;
  let cloudQueue = Promise.resolve();
  try { const saved=JSON.parse(localStorage.getItem(KEY)||"null"); if(saved&&typeof saved==="object") { state={...blank(),...saved,people:Array.isArray(saved.people)?saved.people:[],expenses:Array.isArray(saved.expenses)?saved.expenses:[],borrowings:Array.isArray(saved.borrowings)?saved.borrowings:[]}; if(!Array.isArray(saved.borrowings))state.legacyBorrowed=Number(saved.borrowed)||0; } } catch {}
  const setSyncStatus = (label, error = false) => {
    const status=$("sync-status");
    if(!status)return;
    status.lastChild.textContent=" "+label;
    status.firstElementChild.style.background=error?"var(--mc-red)":"var(--mc-green)";
  };
  const pushCloudSnapshot = (snapshot) => {
    cloudQueue=cloudQueue.then(async()=>{
      const response=await fetch("/api/messculator",{method:"PUT",credentials:"same-origin",headers:{"Content-Type":"application/json"},cache:"no-store",body:snapshot});
      const payload=await response.json().catch(()=>({}));
      if(!response.ok)throw new Error(payload.error||"Cloud save failed.");
      setSyncStatus("Synced to Hulksar");
    }).catch(error=>{
      const message=error instanceof Error?error.message:"Cloud sync unavailable";
      setSyncStatus(/sign in|session/i.test(message)?"Saved on this device · sign in to sync":"Saved on this device · sync unavailable",true);
    });
    return cloudQueue;
  };
  const hasLocalData = () => state.budget>0||state.borrowed>0||state.people.length>0||state.expenses.length>0;
  const save = () => {
    localRevision++;
    const snapshot=JSON.stringify(state);
    try { localStorage.setItem(KEY,snapshot); } catch { alert("This device could not save the budget. Check available browser storage."); return; }
    if(cloudReady)pushCloudSnapshot(snapshot);
  };
  const initializeCloud = async () => {
    const startingRevision=localRevision;
    setSyncStatus("Checking your Hulksar account…");
    try {
      const response=await fetch("/api/messculator",{credentials:"same-origin",cache:"no-store"});
      if(response.status===401){setSyncStatus("Saved on this device · sign in to sync");return;}
      const payload=await response.json().catch(()=>({}));
      if(!response.ok)throw new Error(payload.error||"Could not load your Hulksar budget.");
      if(localRevision!==startingRevision){
        if(payload.exists&&!confirm("A messCulator budget already exists in your Hulksar account. Upload the changes made on this device and replace that account budget?")){setSyncStatus("Saved on this device · cloud sync paused");return;}
        if(!payload.exists&&hasLocalData()&&!confirm("Save this device's existing messCulator budget to your Hulksar account? It will then be available on your other devices.")){setSyncStatus("Saved on this device · cloud sync paused");return;}
        cloudReady=true;
        await pushCloudSnapshot(JSON.stringify(state));
        return;
      }
      if(payload.exists){
        if(hasLocalData()&&JSON.stringify(state)!==JSON.stringify(payload.state)&&!confirm("A budget is already saved to your Hulksar account. Load it here? This replaces this device's local copy. Cancel keeps this device's budget without cloud sync.")){setSyncStatus("Saved on this device · cloud sync paused");return;}
        state={...blank(),...payload.state,people:Array.isArray(payload.state?.people)?payload.state.people:[],expenses:Array.isArray(payload.state?.expenses)?payload.state.expenses:[],borrowings:Array.isArray(payload.state?.borrowings)?payload.state.borrowings:[],legacyBorrowed:Number(payload.state?.legacyBorrowed)||0};
        localStorage.setItem(KEY,JSON.stringify(state));
        render();
        buildCustomFields();
      }else if(hasLocalData()){
        if(!confirm("Save this device's existing messCulator budget to your Hulksar account? It will then be available on your other devices.")){setSyncStatus("Saved on this device · cloud sync paused");return;}
        cloudReady=true;
        await pushCloudSnapshot(JSON.stringify(state));
        return;
      }
      cloudReady=true;
      setSyncStatus("Synced to Hulksar");
    }catch(error){
      setSyncStatus("Saved on this device · sync unavailable",true);
    }
  };
  const totalSpent = () => state.expenses.reduce((sum,e)=>sum+Math.max(0,Number(e.amount)||0),0);
  const activePeople = () => state.people;
  const equalAllocations = (amount) => {
    const people=activePeople();
    const recipients=people.length?people:[{id:"self",name:"You"}];
    const base=Math.floor(amount/recipients.length), remainder=amount-base*recipients.length;
    return recipients.map((p,i)=>({personId:p.id,name:p.name,amount:base+(i<remainder?1:0)}));
  };
  const render = () => {
    const spent=totalSpent(), budget=Number(state.budget)||0, borrowed=Number(state.borrowed)||0, left=budget-spent, cash=budget+borrowed-spent;
    $("budget-display").textContent=money(budget); $("spent-total").textContent=money(spent); $("budget-left").textContent=money(left); $("borrowed-total").textContent=money(borrowed); $("borrow-summary-value").textContent=money(borrowed);
    $("cash-balance").textContent=money(cash); $("cash-balance").style.color=cash<0?"var(--mc-red)":"var(--mc-green)";
    $("cash-caption").textContent=cash<0?"Expenses exceed your budget and borrowed funds.":left<0?"You've used borrowed money to cover the overspend.":"Your budget and borrowed funds are available to spend.";
    $("borrowed-left").textContent=money(Math.max(0,borrowed-Math.max(0,spent-budget)));
    $("spent-label").textContent=money(spent)+" spent"; $("budget-percent").textContent=budget?Math.round(spent/budget*100)+"%":"0%";
    $("budget-progress").style.width=(budget?Math.min(100,spent/budget*100):0)+"%"; $("budget-progress").style.background=left<0?"var(--mc-red)":"#e9a4b0";
    $("people-list").innerHTML=state.people.length?state.people.map(p=>'<span class="mc-person-chip">'+escapeHtml(p.name)+'<button type="button" data-remove-person="'+escapeHtml(p.id)+'" aria-label="Remove '+escapeHtml(p.name)+'">×</button></span>').join(""):'<p class="mc-empty-small">No people added yet. Add people to split expenses.</p>';
    const month=$("report-month").value;
    const visibleExpenses=state.expenses.filter(e=>String(e.createdAt||"").slice(0,7)===month);
    $("expense-count").textContent=visibleExpenses.length+" item"+(visibleExpenses.length===1?"":"s");
    $("expense-list").innerHTML=visibleExpenses.length?visibleExpenses.slice().reverse().map(e=>'<div class="mc-expense"><div class="mc-expense-main"><strong>'+escapeHtml(e.name||"Unnamed expense")+'</strong><small>'+escapeHtml((e.allocations||[]).map(a=>a.name).join(", ")||"No split details")+'</small></div><div class="mc-expense-side"><strong>'+money(e.amount)+'</strong><button type="button" data-delete-expense="'+escapeHtml(e.id)+'">Remove</button></div></div>').join(""):'<div class="mc-empty"><span>◌</span><strong>No expenses this month</strong><p>Choose another month or add an expense.</p></div>';
    const monthExpenses=state.expenses.filter(e=>String(e.createdAt||"").slice(0,7)===month);
    const monthBorrowings=(state.borrowings||[]).filter(b=>String(b.createdAt||"").slice(0,7)===month);
    const monthSpent=monthExpenses.reduce((n,e)=>n+(Number(e.amount)||0),0);
    const monthBorrowed=monthBorrowings.reduce((n,b)=>n+(Number(b.amount)||0),0);
    $("month-expenses").textContent=money(monthSpent); $("month-borrowed").textContent=money(monthBorrowed); $("month-net").textContent=money(monthBorrowed-monthSpent); $("month-net").style.color=monthBorrowed-monthSpent<0?"var(--mc-red)":"var(--mc-green)"; $("month-count").textContent=String(monthExpenses.length+monthBorrowings.length);
    const monthTotals=new Map();
    monthExpenses.forEach(e=>(e.allocations||[]).forEach(a=>{const key=a.personId||a.name;const prev=monthTotals.get(key)||{name:a.name,amount:0};prev.amount+=Number(a.amount)||0;monthTotals.set(key,prev);}));
    const monthPeople=Array.from(monthTotals.values()).sort((a,b)=>b.amount-a.amount);
    $("month-people").innerHTML=monthPeople.length?monthPeople.map(p=>'<div class="mc-month-person"><span>'+escapeHtml(p.name)+'</span><strong>'+money(p.amount)+'</strong></div>').join(""):'<p class="mc-empty-small">No expenses in this month.</p>';
    $("month-borrowing-list").innerHTML=monthBorrowings.length?monthBorrowings.slice().sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt))).map(b=>'<div class="mc-month-borrowing"><span>'+escapeHtml(new Date(b.createdAt).toLocaleDateString("en-IN"))+'</span><strong>'+money(b.amount)+'</strong></div>').join(""):'<p class="mc-empty-small">No borrowing recorded this month.</p>';
    const legacy=Number(state.legacyBorrowed)||0; $("legacy-borrowing-note").hidden=!legacy; $("legacy-borrowing-note").textContent=legacy?money(legacy)+" is older borrowed money saved before monthly borrowing history was introduced, so it is included in your overall borrowed total but not assigned to a month.":"";
    const totals=new Map();
    state.expenses.forEach(e=>(e.allocations||[]).forEach(a=>{const key=a.personId||a.name;const prev=totals.get(key)||{name:a.name,amount:0};prev.amount+=Number(a.amount)||0;totals.set(key,prev);}));
    const list=Array.from(totals.values()).sort((a,b)=>b.amount-a.amount);
    $("split-count").textContent=list.length+" people";
    $("person-breakdown").innerHTML=list.length?list.map(p=>'<div class="mc-person-stat"><small>'+escapeHtml(p.name)+'</small><strong>'+money(p.amount)+'</strong><span>'+ (spent?((p.amount/spent)*100).toFixed(1):"0.0")+'% of expenses</span></div>').join(""):'<p class="mc-empty-small">Add people and expenses to see each person&#39;s share.</p>';
    $("custom-split").hidden=$("split-mode").value!=="custom";
  };
  const buildCustomFields = () => {
    const recipients=activePeople().length?activePeople():[{id:"self",name:"You"}];
    $("custom-fields").innerHTML=recipients.map(p=>'<label class="mc-custom-row"><span>'+escapeHtml(p.name)+'</span><input type="number" min="0" step="0.01" value="0.00" data-person-amount="'+escapeHtml(p.id)+'" aria-label="'+escapeHtml(p.name)+' amount" /></label>').join("");
    updateCustomTotal();
  };
  const updateCustomTotal = () => {
    const sum=Array.from(document.querySelectorAll("[data-person-amount]")).reduce((n,input)=>n+toCents(input.value),0);
    $("custom-total").textContent="Allocated: "+money(sum);
  };
  $("edit-budget").addEventListener("click",()=>{$("budget-amount").value=(state.budget/100).toFixed(2);$("budget-dialog").showModal();});
  $("budget-form").addEventListener("submit",e=>{e.preventDefault();state.budget=toCents($("budget-amount").value);save();render();$("budget-dialog").close();});
  $("expense-form").addEventListener("submit",e=>{
    e.preventDefault(); const amount=toCents($("expense-amount").value), name=$("expense-name").value.trim();
    if(amount<=0){$("expense-status").textContent="Enter an expense amount greater than zero.";return;}
    let allocations;
    if($("split-mode").value==="custom"){
      const fields=Array.from(document.querySelectorAll("[data-person-amount]"));
      allocations=fields.map(input=>{const p=activePeople().find(x=>x.id===input.dataset.personAmount)||{id:"self",name:"You"};return {personId:p.id,name:p.name,amount:toCents(input.value)};});
      const sum=allocations.reduce((n,a)=>n+a.amount,0);
      if(sum!==amount){$("expense-status").textContent="Individual shares must add up exactly to "+money(amount)+".";return;}
    }else allocations=equalAllocations(amount);
    state.expenses.push({id:makeId(),name,amount,allocations,createdAt:new Date().toISOString()});save();render();$("expense-form").reset();$("expense-status").textContent="Expense added.";buildCustomFields();
  });
  $("split-mode").addEventListener("change",()=>{buildCustomFields();render();});
  $("custom-fields").addEventListener("input",updateCustomTotal);
  $("person-form").addEventListener("submit",e=>{e.preventDefault();const name=$("person-name").value.trim();if(!name)return;if(state.people.some(p=>p.name.toLowerCase()===name.toLowerCase())){ $("person-name").setCustomValidity("This person is already added.");$("person-name").reportValidity();return; }$("person-name").setCustomValidity("");state.people.push({id:makeId(),name});save();render();buildCustomFields();$("person-form").reset();});
  $("people-list").addEventListener("click",e=>{const btn=e.target.closest("[data-remove-person]");if(!btn)return;const person=state.people.find(p=>p.id===btn.dataset.removePerson);if(!person)return;if(!confirm("Remove "+person.name+" from the current people list? Existing expense records will keep their saved split."))return;state.people=state.people.filter(p=>p.id!==person.id);save();render();buildCustomFields();});
  $("borrow-form").addEventListener("submit",e=>{e.preventDefault();const amount=toCents($("borrow-amount").value);if(amount<=0)return;state.borrowings.push({id:makeId(),amount,createdAt:new Date().toISOString()});state.borrowed=(Number(state.borrowed)||0)+amount;save();render();$("borrow-form").reset();});
  $("report-month").value=new Date().toISOString().slice(0,7); $("report-month").addEventListener("change",render);
  $("expense-list").addEventListener("click",e=>{const btn=e.target.closest("[data-delete-expense]");if(!btn)return;const expense=state.expenses.find(x=>x.id===btn.dataset.deleteExpense);if(!expense||!confirm("Remove this expense?"))return;state.expenses=state.expenses.filter(x=>x.id!==expense.id);save();render();});
  $("reset-app").addEventListener("click",()=>$("confirm-dialog").showModal());
  $("confirm-reset").addEventListener("click",()=>{state=blank();save();render();$("confirm-dialog").close();$("expense-form").reset();$("borrow-form").reset();buildCustomFields();});
  document.querySelectorAll("[data-close]").forEach(btn=>btn.addEventListener("click",()=>btn.closest("dialog").close()));
  buildCustomFields();render();
  initializeCloud().finally(()=>{if(!state.budget&&!state.borrowed&&!state.people.length&&!state.expenses.length)setTimeout(()=>$("budget-dialog").showModal(),250);});
})();
</script>
