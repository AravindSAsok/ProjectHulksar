  $("people-list").addEventListener("click",e=>{const btn=e.target.closest("[data-remove-person]");if(!btn)return;const person=state.people.find(p=>p.id===btn.dataset.removePerson);if(!person)return;if(!confirm("Remove "+person.name+" from the current people list? Existing expense records will keep their saved split."))return;state.people=state.people.filter(p=>p.id!==person.id);save();render();buildCustomFields();});
  $("borrow-form").addEventListener("submit",e=>{e.preventDefault();const amount=toCents($("borrow-amount").value);if(amount<=0)return;const period=activePeriod();if(!period){alert("Create a calculation period first.");return;}state.borrowings.push({id:makeId(),amount,createdAt:dateForSelectedPeriod(),periodId:period.id,lender:$("borrow-lender").value.trim().slice(0,80)});state.borrowed=(Number(state.borrowed)||0)+amount;save();render();$("borrow-form").reset();});
  $("month-borrowing-list").addEventListener("click",e=>{const edit=e.target.closest("[data-edit-borrowing]"),remove=e.target.closest("[data-delete-borrowing]"),id=edit?.dataset.editBorrowing||remove?.dataset.deleteBorrowing;if(!id)return;const item=state.borrowings.find(b=>b.id===id);if(!item)return;if(remove){if(!confirm("Delete this borrowing record?"))return;state.borrowings=state.borrowings.filter(b=>b.id!==id);state.borrowed=Math.max(0,(Number(state.borrowed)||0)-item.amount);save();render();return;}const amount=prompt("Update borrowed amount (₹):",(item.amount/100).toFixed(2));if(amount===null)return;const cents=toCents(amount);if(cents<=0){alert("Enter an amount greater than zero.");return;}const lender=prompt("Borrowed from (optional):",item.lender||"");if(lender===null)return;state.borrowed=(Number(state.borrowed)||0)-item.amount+cents;item.amount=cents;item.lender=lender.trim().slice(0,80);save();render();});
  if(!state.periods.length){const today=currentMonthValue();state.periods.push({id:makeId(),name:"",startDate:new Date().toISOString().slice(0,10),endDate:"",budget:Number(state.budget)||0});} $("report-month").value=state.periods[state.periods.length-1].id; $("report-month").addEventListener("change",()=>{state.budget=Number(activePeriod()?.budget)||0;render();buildCustomFields();});
  $("expense-list").addEventListener("click",e=>{const edit=e.target.closest("[data-edit-expense]");const btn=e.target.closest("[data-delete-expense]");if(edit){const expense=state.expenses.find(x=>x.id===edit.dataset.editExpense);if(!expense)return;const amount=prompt("Update expense amount (₹):",(expense.amount/100).toFixed(2));if(amount===null)return;const cents=toCents(amount);if(cents<=0){alert("Enter an amount greater than zero.");return;}const name=prompt("Update expense name:",expense.name||"");if(name===null)return;expense.amount=cents;expense.name=name.trim().slice(0,80);const n=expense.allocations?.length||1,base=Math.floor(cents/n),remainder=cents-base*n;expense.allocations=(expense.allocations||[{personId:"self",name:"You"}]).map((a,i)=>({...a,amount:base+(i<remainder?1:0)}));save();render();return;}if(!btn)return;const expense=state.expenses.find(x=>x.id===btn.dataset.deleteExpense);if(!expense||!confirm("Remove this expense?"))return;state.expenses=state.expenses.filter(x=>x.id!==expense.id);save();render();});
  $("reset-app").addEventListener("click",()=>$("confirm-dialog").showModal());
  $("confirm-reset").addEventListener("click",()=>{state=blank();save();render();$("confirm-dialog").close();$("expense-form").reset();$("borrow-form").reset();buildCustomFields();});
  document.querySelectorAll("[data-close]").forEach(btn=>btn.addEventListener("click",()=>btn.closest("dialog").close()));
  buildCustomFields();render();
  cloudInitialization=initializeCloud().finally(()=>{if(!state.budget&&!state.borrowed&&!state.people.length&&!state.expenses.length)setTimeout(()=>$("budget-dialog").showModal(),250);});
})();
</script>
