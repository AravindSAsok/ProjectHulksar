---
import Layout from "../layouts/Layout.astro";
import { HULKSAR_APPS } from "../lib/apps";
const appIds = HULKSAR_APPS.map(app => app.id);
const appCards = HULKSAR_APPS.map(app => `<article class="app-row" data-app-id="${app.id}"><span class="app-icon">${app.icon}</span><div class="app-copy"><strong>${app.name}</strong><small>${app.description}</small></div><div class="order-actions"><button type="button" data-move="up" aria-label="Move ${app.name} up">↑</button><button type="button" data-move="down" aria-label="Move ${app.name} down">↓</button></div></article>`).join("");
---
<Layout title="Your apps — Hulksar" description="Choose your Hulksar home app and arrange your apps.">
<main class="apps-shell"><header class="apps-header"><a class="apps-brand" href="/">HULK<span>SAR</span></a><a href="/">Back to Hulksar</a></header>
<section class="apps-intro"><p class="eyebrow">YOUR HULKSAR SPACE</p><h1>Make it <span>yours.</span></h1><p>Choose which app opens first and arrange your app launcher. Your settings sync to your Hulksar account when you are signed in.</p></section>
<section class="apps-panel"><p class="eyebrow">DEFAULT HOME</p><h2>What should open first?</h2><label class="default-choice">Open Hulksar with<select id="default-app">{HULKSAR_APPS.map(app => <option value={app.id}>{app.name}</option>)}</select></label><p class="hint">Choose Hulksar for your lifestyle dashboard or messCulator to open your finance tracker directly.</p></section>
<section class="apps-panel"><div class="panel-heading"><div><p class="eyebrow">APP ORDER</p><h2>Your apps, your order</h2></div><span class="hint">Move apps up or down</span></div><div id="app-order" class="app-order" set:html={appCards}></div></section>
<div class="apps-actions"><p id="save-status" role="status" aria-live="polite">Loading your preferences…</p><button id="save-apps" type="button">Save preferences</button></div><p class="apps-footnote">New Hulksar apps can be added to this launcher as the platform grows.</p></main>
</Layout>
<style>
:root{--apps-bg:#0d0d10;--apps-panel:#17171c;--apps-border:#2b2b33;--apps-text:#f4f1f2;--apps-muted:#a6a0a4;--apps-accent:#d77b8b}html[data-theme="light"]{--apps-bg:#f6f2f3;--apps-panel:#fff;--apps-border:#e7dfe2;--apps-text:#272126;--apps-muted:#776d72;--apps-accent:#a94f65}.apps-shell{max-width:780px;min-height:100vh;margin:auto;padding:28px 20px 48px;color:var(--apps-text)}.apps-header{display:flex;justify-content:space-between;align-items:center;padding-bottom:20px;border-bottom:1px solid var(--apps-border)}.apps-header a{color:var(--apps-muted);text-decoration:none;font-size:13px}.apps-brand{font-weight:900;letter-spacing:.13em;color:var(--apps-text)!important}.apps-brand span,.apps-intro h1 span{color:var(--apps-accent)}.apps-intro{padding:42px 0 26px}.eyebrow{font-size:10px;letter-spacing:.16em;font-weight:800;color:var(--apps-muted);margin:0 0 9px}.apps-intro h1{font-size:clamp(36px,7vw,54px);letter-spacing:-.06em;margin:0}.apps-intro>p:last-child{color:var(--apps-muted);line-height:1.7;max-width:590px;font-size:14px}.apps-panel{background:var(--apps-panel);border:1px solid var(--apps-border);border-radius:18px;padding:22px;margin:14px 0}.apps-panel h2{font-size:20px;margin:0 0 16px}.default-choice{display:grid;gap:8px;font-size:12px;color:var(--apps-muted)}select{background:var(--apps-bg);border:1px solid var(--apps-border);border-radius:10px;padding:13px;color:var(--apps-text);font:inherit;font-size:16px}.hint{font-size:11px;color:var(--apps-muted);line-height:1.6}.app-order{display:grid;gap:9px}.app-row{display:flex;align-items:center;gap:12px;padding:13px;border:1px solid var(--apps-border);border-radius:13px}.app-icon{display:grid;place-items:center;width:42px;height:42px;background:color-mix(in srgb,var(--apps-accent) 15%,transparent);color:var(--apps-accent);border-radius:12px;font-size:20px}.app-copy{display:grid;gap:4px;min-width:0;flex:1}.app-copy strong{font-size:13px}.app-copy small{font-size:10px;color:var(--apps-muted)}.order-actions{display:flex;gap:6px}.order-actions button{width:36px;height:36px;border:1px solid var(--apps-border);border-radius:9px;background:var(--apps-bg);color:var(--apps-text);font-size:18px}.apps-actions{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-top:18px}.apps-actions p{font-size:11px;color:var(--apps-muted)}.apps-actions button{background:var(--apps-accent);border:0;border-radius:10px;padding:12px 18px;font-weight:800;color:#211419}.apps-footnote{color:var(--apps-muted);font-size:11px;margin-top:22px}@media(max-width:520px){.apps-shell{padding:18px 14px 36px}.apps-panel{padding:17px}.apps-actions{align-items:stretch;flex-direction:column}.apps-actions button{width:100%}}
</style>
<script is:inline>
(() => {
 const KEY="hulksar-app-preferences-v1", ids=${JSON.stringify(appIds)}, $=id=>document.getElementById(id);
 let prefs={defaultApp:"hulksar",order:ids.slice()};
 const normalize=v=>{const order=Array.isArray(v?.order)?v.order.filter(id=>ids.includes(id)):[];ids.forEach(id=>{if(!order.includes(id))order.push(id)});return{defaultApp:ids.includes(v?.defaultApp)?v.defaultApp:"hulksar",order}};
 const render=()=>{const rows=Array.from($("app-order").querySelectorAll(".app-row"));const map=Object.fromEntries(rows.map(row=>[row.dataset.appId,row]));$("app-order").replaceChildren(...prefs.order.map(id=>map[id]).filter(Boolean));$("app-order").querySelectorAll(".app-row").forEach((row,i)=>{row.querySelector('[data-move="up"]').disabled=i===0;row.querySelector('[data-move="down"]').disabled=i===prefs.order.length-1});$("default-app").value=prefs.defaultApp};
 const status=(s)=>{$("save-status").textContent=s};
 try{prefs=normalize(JSON.parse(localStorage.getItem(KEY)||"null"))}catch{} render();
 fetch("/api/app-preferences",{credentials:"same-origin",cache:"no-store"}).then(async r=>{if(r.status===401)return null;const d=await r.json();if(!r.ok)throw Error();return d.preferences}).then(v=>{if(v){prefs=normalize(v);localStorage.setItem(KEY,JSON.stringify(prefs));render();status("Loaded from your Hulksar account")}else status("Guest settings stay on this device")}).catch(()=>status("Using saved settings on this device"));
 $("default-app").addEventListener("change",e=>prefs.defaultApp=e.target.value);
 $("app-order").addEventListener("click",e=>{const b=e.target.closest("[data-move]");if(!b)return;const row=b.closest("[data-app-id]"),from=prefs.order.indexOf(row.dataset.appId),to=from+(b.dataset.move==="up"?-1:1);if(to<0||to>=prefs.order.length)return;[prefs.order[from],prefs.order[to]]=[prefs.order[to],prefs.order[from]];render()});
 $("save-apps").addEventListener("click",async()=>{localStorage.setItem(KEY,JSON.stringify(prefs));status("Saving…");try{const r=await fetch("/api/app-preferences",{method:"PUT",credentials:"same-origin",headers:{"Content-Type":"application/json"},body:JSON.stringify(prefs)});const d=await r.json();if(!r.ok)throw Error();prefs=normalize(d.preferences);localStorage.setItem(KEY,JSON.stringify(prefs));status("Saved and synced to Hulksar")}catch{status("Saved on this device · sign in to sync")}});
})();
</script>
