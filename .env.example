# MongoDB Atlas is the primary application database. Keep this URI server-side.
MONGODB_URI=
MONGODB_DB_NAME=hulksar

# MongoDB-backed email/password authentication uses the existing MONGODB_URI.
# AI provider keys are used only by server-side API routes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=
OPENROUTER_API_KEY=

# Optional USDA FoodData Central API key. Without one, the limited public DEMO_KEY is used.
USDA_FDC_API_KEY=

# Optional Gemini Google Search grounding. Disabled by default to prevent unexpected search charges.
GEMINI_WEB_SEARCH_ENABLED=false
GEMINI_WEB_SEARCH_MODEL=gemini-3.6-flash
